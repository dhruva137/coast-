<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PERMISSIONS. Every one of these is justified in android/README.md and is
        actually reached by code in this app. Nothing is declared "to match the
        problem statement" or "in case we need it later".

        Deliberately ABSENT, and each absence is load-bearing:
          * ACCESS_BACKGROUND_LOCATION - the foreground service covers the only
            real case (screen off, still riding). Play reviews this one by hand
            and it would be a lie here.
          * BODY_SENSORS - the IMU is not a body sensor. Accelerometer and
            gyroscope need no runtime grant at all.

        INTERNET is present — see the block below. Never claim this app has
        "no INTERNET permission".
    -->

    <!-- Live dead reckoning and CSV logging must survive the screen going off. -->
    <!--
        INTERNET and ACCESS_NETWORK_STATE exist ONLY so MapLibre can fetch and
        cache public OSM/Carto basemap tiles. Declared for public OSM/Carto
        basemap tiles only; with basemap off, network traffic is zero.

        What still holds: no analytics and no crash reporting. Navigation itself
        runs with the radio off — that is the product point. Optional outbound
        traffic: (1) public map-tile requests when basemap is on; (2) console
        pairing ingest (`POST /ingest`) only after the user consents and pairs
        with a laptop QR — token + lat/lon/mode/speed/accuracy, never a device ID.
        Continuous LAN tracking to tracker_server exists only in the tracker flavour.

        Turning the basemap off in the app (SHOW GRID INSTEAD) removes the
        traffic with it: the app falls back to its own Canvas map and makes no
        network call at all.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: one per declared foregroundServiceType on the service below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+: the ongoing notification that says tracking is running. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The CPU must stay awake to integrate the IMU with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional at runtime. The app arms and navigates without either. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Console QR scan (optional). Manual code entry works if denied. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- API 31+: required to sample above 200 Hz (SENSOR_DELAY_FASTEST).
         Normal-level, granted at install, not shown to the user. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <!--
        Not required. A gyroscope is what dead reckoning wants, but marking it
        required makes Play filter the app off every device without one, and
        that contradicts the runtime capability check in sensor/DeviceProbe.kt,
        which detects the absence and degrades instead of failing. The gate is
        the runtime verdict surfaced in Vehicle Check, not store filtering.
    -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />
    <!-- Not required: the whole point is that it works without a fix. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".IdrApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IDR"
        android:usesCleartextTraffic="true">

        <!--
            Cleartext is on so venue LAN pairing can POST http://<laptop>:8787/ingest
            without a TLS cert on the demo laptop. No third-party analytics endpoints.
            Map tiles remain HTTPS when basemap is on.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.IDR.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="coast"
                    android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            location  - GNSS is sampled while the service runs, whenever the user
                        has granted it. RecordService drops this type at runtime
                        when the permission is absent rather than crashing.
            dataSync  - RECORD mode streams IMU and GNSS rows to CSV files in the
                        app's own external files directory for the whole session.

            This used to declare specialUse, which requires a written
            justification reviewed by hand on every Play submission. The two
            standard types describe what the service does accurately, so the
            special case was not needed.
        -->
        <service
            android:name=".record.RecordService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
