<?xml version="1.0" encoding="utf-8"?>
<!--
  COAST mark: a navigation arrow with a fading breadcrumb trail behind it —
  the position keeps moving after the signal stops.

  Adaptive-icon geometry: 108dp canvas, 72dp masked, 66dp safe zone. All art is
  kept inside a 33dp radius of the centre (54,54) so no launcher mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00D4AA"
        android:pathData="M54,24 L70,60 L54,51 L38,60 Z"
        android:strokeLineJoin="round" />

    <path
        android:strokeColor="#00D4AA"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeAlpha="0.75"
        android:pathData="M54,67 L54,73" />

    <path
        android:strokeColor="#00D4AA"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4"
        android:pathData="M54,80 L54,84" />
</vector>
