<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+. The app already sets android:allowBackup="false", so neither
    cloud backup nor device-to-device transfer runs. These rules state the
    same thing explicitly, which is what a reviewer looks for.

    Ride logs are raw IMU and GNSS traces of where a person actually went.
    They stay on the phone that recorded them. The only way one leaves is the
    user choosing SHARE on a session zip in the SESSIONS tab.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
