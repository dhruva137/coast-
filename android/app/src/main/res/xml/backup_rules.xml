<?xml version="1.0" encoding="utf-8"?>
<!--
    API 30 and below. Same policy as data_extraction_rules.xml: nothing this
    app writes is eligible for backup. Ride logs never leave the device except
    by an explicit user share.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
