<?xml version="1.0" encoding="utf-8"?>
<!--
    API 33+ per-app language list. Every string in this app is English; naming
    the one locale stops Android offering a language picker that would do
    nothing, and stops Play listing locales the app does not have.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
</locale-config>
