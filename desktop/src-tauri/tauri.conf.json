{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDR",
  "version": "0.1.0",
  "identifier": "in.sih26168.idr",
  "build": {
    "devUrl": "http://localhost:26168",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IDR · SIH 26168 · Intelligent Dead Reckoning",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
